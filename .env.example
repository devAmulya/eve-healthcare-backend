# Copy this file to .env and fill in real values before running.

# Postgres connection string used by docker-compose / production.
# Local pytest runs ignore this and use an isolated SQLite file instead.
DATABASE_URL=postgresql://eve_user:eve_pass@db:5432/eve_healthcare

# Secret used to sign JWTs. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
